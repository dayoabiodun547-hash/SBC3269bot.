# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=your_bot_token_here

# Path to the SQLite database file
DB_PATH=links.db

# Railway sets this automatically for web services — no need to set it yourself
PORT=8080

# IMPORTANT: set this AFTER your first deploy, once Railway shows you the
# public domain for this service (Settings -> Networking -> Public Networking).
# Example: BASE_URL=https://linkshortener-bot-production.up.railway.app
BASE_URL=
